{
  "name": "campusflow",
  "version": "0.1.0",
  "private": true,
  "description": "CampusFlow — 高校学生组织招新与协作管理平台",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/check-node.mjs",
    "dev:rsvp": "npm run dev --",
    "start": "npm run dev",
    "prebuild": "node scripts/check-node.mjs",
    "dev": "vite --mode rsvp-demo",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run typecheck && npm run test && npm run check:secrets",
    "ai:server": "node scripts/ai-server.mjs"
  },
  "dependencies": {
